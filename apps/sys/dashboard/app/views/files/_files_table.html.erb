<div class="col-md-9">
  <%# TODO put search box ABOVE the breadcrumbs %>
  <div class='mt-3'>

    <ol id="path-breadcrumbs" class="breadcrumb breadcrumb-no-delimiter">
      <%= render partial: 'breadcrumb', collection: @path.descend, as: :file, locals: { file_count: @path.descend.count, full_path: @path } %>
    </ol>

    <table class="table table-striped table-condensed w-100" id="directory-contents">
      <thead>
        <tr>
          <th>
             <input type="checkbox" id="select_all" title="Select All"></input>
          </th>
          <th> 유형 <span aria-hidden="true"></span></th>
          <th> 이름 <span aria-hidden="true"></span></th>
          <th><span class="sr-only"> 작업 </span></th>
          <th> 크기 <span aria-hidden="true"></span></th>
          <th> 수정시각 <span aria-hidden="true"></span></th>
          <th> 소유자 <span aria-hidden="true"></span></th>
          <th> 권한 <span aria-hidden="true"></span></th>
        </tr>
      </thead>
      <tbody>
      </tbody>
    </table>
    <%= render partial: "spinner" %>
  </div>
</div>

</div>
